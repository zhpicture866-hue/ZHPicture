APP_NAME=ZHPicture
APP_ENV=local
APP_KEY=base64:+mLbz/o6VhmQdQRm4EVbRbemnRyq1QlyH8y6ElG2AL8=
APP_DEBUG=true
APP_URL=http://zhpicture.test:8080
APP_TIMEZONE=Asia/Jakarta

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12
HASH_DRIVER=argon2id

ARGON_MEMORY=65536
ARGON_THREADS=4
ARGON_TIME=4

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION="pgsql"
DB_HOST="${{Postgres.PGHOST}}"
DB_PORT="${{Postgres.PGPORT}}"
DB_DATABASE="${{Postgres.PGDATABASE}}"
DB_USERNAME="${{Postgres.PGUSER}}"
DB_PASSWORD="${{Postgres.PGPASSWORD}}"

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

SSO_AUTHORIZE_URL=http://lebihtersistem.test:8080/sso/authorize
SSO_CLIENT_ID=zhpicture
SSO_REDIRECT_URI=http://zhpicture.test:8080/sso/callback

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
CACHE_PREFIX=zhpicture_cache

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

WKHTML_PDF_BINARY=D:/laragon/bin/wkhtmltopdf/wkhtmltopdf.exe
WKHTML_IMAGE_BINARY=D:/laragon/bin/wkhtmltopdf/wkhtmltoimage.exe